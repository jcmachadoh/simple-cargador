<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- RNF-07: solo permisos mínimos. INTERNET se usa únicamente en el pago Enzona. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Permite abrir la app automáticamente al conectar el cargador (arranque desde segundo plano) -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Servicio en primer plano durante la carga: evita que el OEM congele la app (RF-01/02) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Permite pedir al usuario excluir la app de la optimización de batería (ROMs agresivas) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Permite instalar la APK descargada a través del instalador del sistema (actualización in-app) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Paso 3: visibilidad del paquete Enzona en Android 11+ (query) -->
    <queries>
        <package android:name="cu.xetid.apk.enzona" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SimpleCargadorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/rayo_1"
        android:label="@string/app_name"
        android:roundIcon="@drawable/rayo_1"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleCargador">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enzona deep-link: return_url / cancel_url (paso 4) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="simplecargador"
                    android:host="enzona" />
            </intent-filter>
        </activity>

        <!-- RF-01: detección de conexión/desconexión del cargador -->
        <receiver
            android:name=".utils.receivers.ChargingBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- RNF-08: recuperación de sesiones tras reinicio -->
        <receiver
            android:name=".utils.receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- RF-09: widget redimensionable -->
        <receiver
            android:name=".widget.BatteryWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <!-- RF-01/RF-02: ancla la app en primer plano durante cada sesión de carga -->
        <service
            android:name=".utils.services.ChargingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitorea la sesión de carga de la batería para registrarla sin depender de la nube" />
        </service>

        <!-- RF-10: compartir exportaciones CSV/JSON -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
